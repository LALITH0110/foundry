{
  "schemaVersion": "1.0",
  "id": "lookup_member_account",
  "version": "1.0.0-discovered",
  "description": "Look up a member by member number and confirm a specific deposit account exists on their profile.",
  "vendor": "LegacyBank CoreServicing",
  "compatibleVersions": [
    "7.4"
  ],
  "lifecycle": "draft",
  "entry": {
    "path": "/servicing"
  },
  "inputSchema": {
    "memberId": {
      "type": "string",
      "required": true,
      "sensitive": true,
      "pattern": "^\\d{5}$"
    },
    "accountSuffix": {
      "type": "string",
      "required": true,
      "sensitive": true,
      "pattern": "^\\d{4}$"
    }
  },
  "outputSchema": {
    "status": {
      "type": "string"
    },
    "memberId": {
      "type": "string",
      "sensitive": true
    },
    "memberName": {
      "type": "string",
      "sensitive": true
    },
    "accountSuffix": {
      "type": "string",
      "sensitive": true
    }
  },
  "targets": {
    "discovered-target-1": {
      "kind": "tableRowControl",
      "frame": "workspace",
      "rowText": "Member number",
      "control": "input"
    },
    "discovered-target-2": {
      "kind": "role",
      "frame": "workspace",
      "role": "button",
      "name": "Search member",
      "exact": true
    },
    "member-id-value": {
      "kind": "tableRowValue",
      "frame": "workspace",
      "rowText": "Member number"
    },
    "member-name-value": {
      "kind": "tableRowValue",
      "frame": "workspace",
      "rowText": "Member name"
    },
    "account-link": {
      "kind": "tableRowLink",
      "frame": "workspace",
      "rowTexts": [
        {
          "kind": "input",
          "name": "accountSuffix"
        }
      ],
      "linkName": "Open account"
    },
    "member-not-found": {
      "kind": "text",
      "frame": "workspace",
      "text": "No member was found for that member number.",
      "exact": true
    },
    "session-expired": {
      "kind": "text",
      "frame": "workspace",
      "text": "Session expired",
      "exact": true
    },
    "app-error": {
      "kind": "text",
      "frame": "workspace",
      "text": "CORE-503: The servicing host is temporarily unavailable.",
      "exact": true
    },
    "known-interstitial": {
      "kind": "text",
      "frame": "workspace",
      "text": "Account notice",
      "exact": true
    },
    "dismiss-interstitial": {
      "kind": "role",
      "frame": "workspace",
      "role": "link",
      "name": "Continue",
      "exact": true
    }
  },
  "steps": [
    {
      "id": "open-entry",
      "action": {
        "kind": "navigate",
        "path": "/servicing"
      },
      "effect": "read",
      "postcondition": {
        "kind": "urlPath",
        "path": "/workspace/search"
      },
      "timeoutMs": 5000
    },
    {
      "id": "discovered-1",
      "action": {
        "kind": "fill",
        "target": "discovered-target-1",
        "value": {
          "kind": "input",
          "name": "memberId"
        }
      },
      "effect": "reversible",
      "precondition": {
        "kind": "urlPath",
        "path": "/workspace/search"
      },
      "timeoutMs": 5000
    },
    {
      "id": "discovered-2",
      "action": {
        "kind": "click",
        "target": "discovered-target-2"
      },
      "effect": "reversible",
      "precondition": {
        "kind": "urlPath",
        "path": "/workspace/search"
      },
      "postcondition": {
        "kind": "urlPath",
        "path": "/workspace/member"
      },
      "timeoutMs": 5000
    }
  ],
  "handlers": [
    {
      "id": "known-interstitial",
      "when": {
        "kind": "visible",
        "target": "known-interstitial"
      },
      "result": {
        "status": "recoverable",
        "action": {
          "kind": "click",
          "target": "dismiss-interstitial"
        },
        "postcondition": {
          "kind": "urlPath",
          "path": "/workspace/member"
        },
        "maxAttempts": 1
      }
    },
    {
      "id": "member-not-found",
      "when": {
        "kind": "visible",
        "target": "member-not-found"
      },
      "result": {
        "status": "business_outcome",
        "code": "MEMBER_NOT_FOUND"
      }
    },
    {
      "id": "session-expired",
      "when": {
        "kind": "visible",
        "target": "session-expired"
      },
      "result": {
        "status": "intervention_required",
        "code": "SESSION_EXPIRED"
      }
    },
    {
      "id": "app-error",
      "when": {
        "kind": "visible",
        "target": "app-error"
      },
      "result": {
        "status": "failed",
        "code": "APP_ERROR"
      }
    }
  ],
  "success": {
    "predicate": {
      "kind": "all",
      "checks": [
        {
          "kind": "urlPath",
          "path": "/workspace/member"
        },
        {
          "kind": "textEquals",
          "target": "member-id-value",
          "value": {
            "kind": "input",
            "name": "memberId"
          }
        },
        {
          "kind": "visible",
          "target": "account-link"
        }
      ]
    },
    "outputs": {
      "status": {
        "kind": "constant",
        "value": "member_verified"
      },
      "memberId": {
        "kind": "extract",
        "target": "member-id-value",
        "parse": "text"
      },
      "memberName": {
        "kind": "extract",
        "target": "member-name-value",
        "parse": "text"
      },
      "accountSuffix": {
        "kind": "input",
        "name": "accountSuffix"
      }
    }
  },
  "policyProfile": "legacybank-review-only-v1",
  "provenance": {
    "kind": "discovered",
    "discoveryRunId": "2b39bddf-a2aa-419d-a969-10af15b8f70a",
    "model": "qwen3:4b",
    "note": "Executed steps were compiled from the model run; inputs, outputs, outcomes, and success criteria are engineer-authored contract. 0 of 2 discovered steps matched a pre-authored control and inherited its effect and checkpoints; the remaining 2 carry observed checkpoints and a conservative reversible effect pending review."
  }
}
